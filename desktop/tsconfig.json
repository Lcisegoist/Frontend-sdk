{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "es2016"],
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "baseUrl": ".",
    "jsx": "react",
    "paths": {
      "@/src/*": ["./src/*"],
    },
    "noEmit": true,  // 告诉 TypeScript 不要输出文件
    "isolatedModules": true  // 建议添加
  },
  "files": ["./index.d.ts"],
  "include": ["src/**/*"],
  "exclude": ["node_modules"],
}
